# Familien-Server (Supabase). Kopieren nach .env.local und ausfüllen.
# Ohne diese Werte läuft das Spiel nur lokal auf dem jeweiligen Gerät.
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
# Den "publishable" bzw. "anon" Key verwenden – niemals den geheimen "service_role"/"secret" Key!
VITE_SUPABASE_KEY=sb_publishable_...
